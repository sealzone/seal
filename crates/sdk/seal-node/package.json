{
  "name": "@sealzone/sdk",
  "version": "0.2.1",
  "description": "Seal: use secrets without holding them.",
  "license": "Apache-2.0",
  "homepage": "https://seal.zone",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "errors.js",
    "native.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "napi": {
    "binaryName": "seal",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "optionalDependencies": {
    "@sealzone/sdk-linux-x64-gnu": "0.2.1",
    "@sealzone/sdk-linux-arm64-gnu": "0.2.1",
    "@sealzone/sdk-linux-x64-musl": "0.2.1",
    "@sealzone/sdk-linux-arm64-musl": "0.2.1",
    "@sealzone/sdk-darwin-x64": "0.2.1",
    "@sealzone/sdk-darwin-arm64": "0.2.1"
  },
  "scripts": {
    "build": "./build.sh --release",
    "build:debug": "./build.sh",
    "build:sim": "./build.sh --sim",
    "test": "node --test test/unit.test.mjs"
  }
}
